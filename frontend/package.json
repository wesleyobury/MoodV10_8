{
  "name": "frontend",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "sync-env": "node ./scripts/sync-env.js",
    "prestart": "node ./scripts/sync-env.js",
    "postinstall": "rm -rf node_modules/mood-healthkit node_modules/mood-storekit && cp -RL modules/mood-healthkit node_modules/mood-healthkit && cp -RL modules/mood-storekit node_modules/mood-storekit && echo '===EAS POSTINSTALL DIAG===' && ls -la node_modules/mood-healthkit node_modules/mood-storekit",
    "start": "expo start --clear --tunnel --port 3000",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "reset": "rm -rf node_modules/.cache .expo .metro-cache && (command -v watchman >/dev/null 2>&1 && watchman watch-del-all || true) && expo start --clear --tunnel --port 3000",
    "env:dev": "cp .env.development .env && echo '\u2192 .env now mirrors .env.development'",
    "env:preview": "cp .env.preview .env && echo '\u2192 .env now mirrors .env.preview'",
    "env:prod": "cp .env.production .env && echo '\u2192 .env now mirrors .env.production'",
    "verify": "../scripts/verify-deploy.sh",
    "test:cart-hero": "node --import tsx --test utils/cartHero.test.ts",
    "test:in-session-progress": "node --import tsx --test utils/inSessionProgress.test.ts",
    "test:featured-hero": "node --import tsx --test utils/featuredHeroImage.test.ts",
    "preflight": "bash scripts/preflight-build.sh",
    "build:ios:dev": "yarn preflight && eas build --profile development --platform ios --clear-cache",
    "build:ios:tf": "yarn preflight && eas build --profile preview --platform ios --clear-cache"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "5.0.1",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "axios": "^1.11.0",
    "expo": "54.0.33",
    "expo-apple-authentication": "^8.0.8",
    "expo-av": "^16.0.8",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "^18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "^8.0.10",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-crop-tool": "^0.4.0",
    "expo-image-manipulator": "^14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "^17.0.8",
    "expo-media-library": "~18.2.1",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-secure-store": "^15.0.8",
    "expo-sharing": "^14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.17",
    "expo-video": "^3.0.0",
    "expo-video-thumbnails": "^10.0.8",
    "expo-web-browser": "~15.0.11",
    "html2canvas": "^1.4.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-dotenv": "^3.4.11",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-popover-view": "^6.1.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-share": "^12.2.5",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "^4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "mood-healthkit": "*",
    "mood-storekit": "*"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "workspaces": [
    "modules/*"
  ]
}