{
  "expo": {
    "name": "MOOD",
    "slug": "mood-fitness-app",
    "version": "3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moodapp",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.official.moodapp",
      "buildNumber": "82",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDisplayName": "MOOD",
        "UIViewControllerBasedStatusBarAppearance": false,
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "NSCameraUsageDescription": "MOOD only asks for camera access if you choose to take a photo in the app, such as a profile picture.",
        "NSPhotoLibraryUsageDescription": "MOOD uses your photo library so you can choose a profile picture.",
        "NSPhotoLibraryAddUsageDescription": "MOOD saves workout summary images to your photo library when you choose to save or share them.",
        "NSMicrophoneUsageDescription": "MOOD only asks for microphone access if you choose to record video with sound in the app.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "instagram",
          "instagram-stories"
        ]
      }
    },
    "android": {
      "package": "com.official.moodapp",
      "versionCode": 10,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "notification": {
        "icon": "./assets/images/notification-icon.png",
        "color": "#FFD700"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "backgroundColor": "#000000",
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 400,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "ios": {
            "image": "./assets/images/splash-screen-ios.png",
            "resizeMode": "cover",
            "backgroundColor": "#000000"
          }
        }
      ],
      "./plugins/withCxx17Fix",
      "./plugins/withMoodHealthKit",
      "./plugins/withMoodHealthKitAndroid",
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      "expo-localization"
    ],
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ef2c8520-832c-4806-beb0-80b9db1a6214"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/ef2c8520-832c-4806-beb0-80b9db1a6214",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "3.0.0"
  }
}
